# Local development env for running automations + the learning-cache loop.
# Copy to a file and point the engine at it with:  export ENV_PATH=/abs/path/to/.env
# (Settings also reads these straight from the process environment.)

# --- optexity engine (required) ---
OPTEXITY_API_KEY=your_optexity_api_key   # from https://dashboard.optexity.com (alias: API_KEY)
DEPLOYMENT=dev                           # dev | prod

# --- LLM for the agentic (browser-use) capture step ---
# handle_agentic_task.py drives Gemini Flash via browser-use's ChatGoogle.
# Note: optexity's own Gemini model class reads GOOGLE_API_KEY specifically.
GOOGLE_API_KEY=your_gemini_api_key

# --- dev override (opt-in) ---
# Unset (default) => REAL automations run, so real-endpoint testing is unaffected.
# Set to a path (or 1/true for ./test_automation.json) to run a local automation instead,
# e.g. to iterate the learning-cache loop against the captcha-free roboform fixture.
# OPTEXITY_TEST_AUTOMATION=test_automation.json

# --- learning-cache self-repair toggles (opt-in; default off) ---
# OPTEXITY_CACHE_VERIFY=1          # fingerprint-verify cached locators before acting
# OPTEXITY_CACHE_HEAL=1            # relearn + persist locators that fall back to the LLM
# OPTEXITY_CACHE_SERVE=1          # REUSE: serve a per-endpoint cached automation on later
#                                 # runs (and seed it from agentic runs). Without this the
#                                 # cache is written but never read back automatically.
# Cache is keyed per endpoint: one entry per endpoint under OPTEXITY_CACHE_DIR, so many
# endpoints coexist (100s) without overwriting. Capacity is disk-bound (~KB each).
# OPTEXITY_CACHE_DIR=optexity_cache
# OPTEXITY_CACHE_HEAL_PATH=         # set to force a single shared file instead of per-endpoint

# --- optional ---
# SERVER_URL=https://api.optexity.com
# BROWSER_USE_API_KEY=
# PROXY_URL=
