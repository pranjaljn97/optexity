# Local development env for running automations + the learning-cache loop.
# Copy to a file and point the engine at it with:  export ENV_PATH=/abs/path/to/.env
# (Settings also reads these straight from the process environment.)

# --- optexity engine (required) ---
OPTEXITY_API_KEY=your_optexity_api_key   # from https://dashboard.optexity.com (alias: API_KEY)
DEPLOYMENT=dev                           # dev | prod

# --- LLM for the agentic (browser-use) capture step ---
# handle_agentic_task.py drives Gemini Flash via browser-use's ChatGoogle.
GOOGLE_API_KEY=your_gemini_api_key

# --- optional ---
# SERVER_URL=https://api.optexity.com
# BROWSER_USE_API_KEY=
# PROXY_URL=
